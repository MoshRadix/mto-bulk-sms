{
  "name": "mto-bulk-sms-manager",
  "version": "0.1.0",
  "description": "Bulk SMS management for Maradhoo Town Office, Addu City Council",
  "license": "ISC",
  "author": "Maradhoo Town Office (MTO)",
  "type": "commonjs",
  "main": "dist-electron/main.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "vite",
    "start": "npm run build && electron .",
    "build:electron": "tsc -p tsconfig.node.json",
    "build": "npm run build:electron && vite build",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "electron-store": "^8.2.0",
    "keytar": "^7.9.0",
    "mongoose": "^8.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.14.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "productName": "MTO Bulk SMS Manager",
  "build": {
    "appId": "mv.gov.addu.maradhoo.bulksms",
    "productName": "MTO Bulk SMS Manager",
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
