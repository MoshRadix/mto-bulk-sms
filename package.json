{
  "name": "mto-bulk-sms-manager",
  "version": "0.1.0",
  "description": "Bulk SMS management for Maradhoo Town Office, Addu City Council",
  "license": "ISC",
  "author": "Maradhoo Town Office (MTO)",
  "type": "commonjs",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "start": "npm run build && electron .",
    "build:electron": "tsc -p tsconfig.node.json",
    "build": "npm run build:electron && vite build",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --win",
    "release": "npm run build && electron-builder --win --publish always"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "keytar": "^7.9.0",
    "lucide": "^1.49.0",
    "mongoose": "^8.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.14.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "productName": "MTO Bulk SMS Manager",
  "build": {
    "appId": "mv.gov.addu.maradhoo.bulksms",
    "productName": "MTO Bulk SMS Manager",
    "files": [
      "dist/**",
      "dist-electron/**",
      "assets/addu city logo.png",
      "assets/addu-city-icon.png",
      "assets/mtobulksms.ico"
    ],
    "win": {
      "icon": "assets/mtobulksms.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MTO Bulk SMS Manager",
      "installerIcon": "assets/mtobulksms.ico",
      "uninstallerIcon": "assets/mtobulksms.ico",
      "installerHeaderIcon": "assets/mtobulksms.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "MoshRadix",
      "repo": "mto-bulk-sms",
      "releaseType": "release"
    }
  }
}
